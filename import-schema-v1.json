{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.example/schemas/cet4-vocabulary-import-v1.json",
  "title": "CET-4 Vocabulary Import Schema v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source", "words"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "enum": ["reading", "listening", "writing", "translation", "other"] },
        "date": { "type": ["string", "null"], "format": "date" },
        "description": { "type": ["string", "null"], "maxLength": 2000 }
      }
    },
    "words": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["word", "lemma", "meanings"],
        "properties": {
          "word": { "type": "string", "minLength": 1, "maxLength": 120, "description": "原文中遇到的词形" },
          "lemma": { "type": "string", "minLength": 1, "maxLength": 120, "description": "规范原形；用于去重" },
          "phonetic": { "type": ["string", "null"], "maxLength": 160 },
          "meanings": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false, "required": ["pos", "zh"],
              "properties": { "pos": { "type": "string", "minLength": 1, "maxLength": 30 }, "zh": { "type": "string", "minLength": 1, "maxLength": 1000 } }
            }
          },
          "word_family": { "type": "array", "maxItems": 30, "uniqueItems": true, "items": { "type": "string" }, "default": [] },
          "priority": { "enum": ["high", "normal", "low"], "default": "normal" },
          "context": { "type": ["string", "null"], "maxLength": 4000 },
          "note": { "type": ["string", "null"], "maxLength": 2000 }
        }
      }
    }
  }
}

